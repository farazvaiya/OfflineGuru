    {
      "id": "fc120f604918",
      "session_id": "e8af30b98889",
      "seq": 8,
      "start_s": 33.4,
      "end_s": 39.44,
      "en": "During photosynthesis, plants take in carbon dioxide from the air through tiny pores called stomata.",
      "bn": "শোভাযাত্রার সময়, উদ্ভিদগুলো আকাশ থেকে কার্বান ডাই অক্সাইডে ধারণ করে, যা স্টোমাটা নামক ছোট পোর দিয়ে।",
      "confidence": 0.9465466461886577,
      "asr_ms": 1355.9053829999357,
      "translate_ms": 373.9,
      "tts_ms": 741.3,
      "total_ms": 1730.4,
      "numbers_preserved": 1,
      "audio_path": "/home/faraz/project/offline_guru/data/audio/e8af30b98889/fc120f604918.wav",
      "created_at": 1792438516.5684738
