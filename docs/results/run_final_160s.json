    {
      "id": "7c60a414c274",
      "session_id": "e8af30b98889",
      "seq": 2,
      "start_s": 4.14,
      "end_s": 9.08,
      "en": "Photosynthesis is the process by which green plants make their own food using sunlight.",
      "bn": "ফটোসিনথেসিস হচ্ছে এই প্রক্রিয়া যার মাধ্যমে সবুজ উদ্ভিদ সূর্যাস্তের মাধ্যমে নিজেদের খাদ্য তৈরি করে।",
      "confidence": 0.9495799897975927,
      "asr_ms": 1616.5595140000732,
      "translate_ms": 264.8,
      "tts_ms": 769.9,
      "total_ms": 1881.9,
      "numbers_preserved": 1,
