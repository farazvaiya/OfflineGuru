      "session_id": "e8af30b98889",
      "seq": 5,
      "start_s": 20.24,
      "end_s": 24.56,
      "en": "Plants use a green pigment called chlorophyll to capture light energy.",
      "bn": "উদ্ভিদগুলি হালকা শক্তি অর্জনের জন্য ক্লোরোফিল নামে একটি সবুজ রঞ্জক ব্যবহার করে।",
      "confidence": 0.9556967044691465,
      "asr_ms": 1295.7950310001252,
      "translate_ms": 215.6,
      "tts_ms": 428.2,
      "total_ms": 1512.0,
      "numbers_preserved": 1,
      "audio_path": "/home/faraz/project/offline_guru/data/audio/e8af30b98889/199e36f4c487.wav",
